<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title><%= produto.nome %> | WebFit</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/cliente.css">
</head>
<body>
<header class="topo">
    <a class="marca" href="/">WebFit</a>
    <nav>
        <a href="/pratos">Pratos</a>
        <a href="/carrinho">Carrinho</a>
    </nav>
</header>

<main class="container py-5">
    <a class="voltar" href="/pratos">← Voltar aos pratos</a>

    <div class="detalhe-prato mt-4">
        <div class="detalhe-imagem">
            <% if (produto.imagem) { %>
                <img src="/uploads/<%= produto.imagem %>" alt="<%= produto.nome %>">
            <% } else { %>
                <div class="imagem-sem-foto grande">🥗</div>
            <% } %>
        </div>

        <div class="detalhe-conteudo">
            <p class="etiqueta"><%= produto.categoria %></p>
            <h1><%= produto.nome %></h1>
            <p><%= produto.descricao %></p>

          <form action="/carrinho/adicionar/<%= produto.id %>" method="post">
    <button type="submit">Adicionar ao carrinho</button>
</form>

  <div class="preco-detalhe">
      <strong>R$ <%= produto.valor.toFixed(2).replace('.', ',') %></strong>
  </div>

    <a class="link-carrinho" href="/carrinho">Ver carrinho</a>
</div>
    </div>
</main>

<footer>WebFit · Refeições saudáveis para todos os dias</footer>
</body>
</html>