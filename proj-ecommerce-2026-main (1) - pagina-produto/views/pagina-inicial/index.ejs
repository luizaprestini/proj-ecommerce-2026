
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WebFit | Refeições saudáveis</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/cliente.css">
</head>
<body>

<header class="topo">
    <a class="marca" href="/">WebFit</a>

    <nav>
        <a href="/pratos">Todos os pratos</a>
        <a href="/carrinho">
            Carrinho <span><%= quantidadeCarrinho %></span>
        </a>
        <a href="/admin">Administradores</a>
    </nav>
</header>

<main>
    <section class="apresentacao">
        <p class="etiqueta">COMA BEM, VIVA MELHOR</p>

        <h1>Refeições saudáveis<br>para a sua rotina.</h1>

        <p>
            Encontre pratos preparados para diferentes gostos e objetivos.
        </p>

        <a class="botao" href="/pratos">Ver pratos</a>
    </section>

    <section class="categorias container py-5">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
            <div>
                <p class="etiqueta">ESCOLHA O QUE COMBINA COM VOCÊ</p>
                <h2>Explore por categoria</h2>
            </div>

            <a href="/pratos">Ver todos os pratos →</a>
        </div>

        <% if (categorias.length === 0) { %>

            <div class="aviso">
                Ainda não há categorias cadastradas.
                Entre na área administrativa e cadastre as categorias primeiro.
            </div>

        <% } else { %>

            <div class="grade-categorias">
                <% categorias.forEach(categoria => { %>

                    <a class="categoria"
                       href="/pratos?categoria=<%= encodeURIComponent(categoria.nome) %>">

                        <span class="icone-categoria">🥗</span>

                        <strong><%= categoria.nome %></strong>

                        <span class="descricao-categoria">
                            <%= categoria.descricao || 'Confira os pratos desta categoria.' %>
                        </span>

                    </a>

                <% }) %>
            </div>

        <% } %>
    </section>
</main>

<footer>
    WebFit · Refeições saudáveis para todos os dias
</footer>

</body>
</html>
