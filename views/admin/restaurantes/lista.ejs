<%- include('../partials/header') %>
<%- include('../partials/menu') %>

<main class="container py-4">

    <div class="card shadow-sm">

        <div class="card-header bg-success text-white">
            <div class="d-flex justify-content-between">
                <h4 class="mb-0">
                    <i class="bi bi-tags"></i>
                    Restaurantes
                </h4>

                <a href="/admin/restaurantes/form-cadastrar" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle"></i>
                    Novo restaurante
                </a>
            </div>
        </div>

        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-striped table-hover">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Descrição</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% if (restaurantes.length === 0) { %>
                            <tr>
                                <td colspan="4" class="text-center">Nenhum restaurante cadastrado.</td>
                            </tr>
                        <% } else { %>
                            <% restaurantes.forEach(restaurante => { %>
                                <tr>
                                    <td><%= restaurante.id %></td>
                                    <td><%= restaurante.nome %></td>
                                    <td><%= restaurante.descricao %></td>

                                    <td>
                                        <a href="/admin/restaurantes/<%= restaurante.id %>/editar" class="btn btn-warning btn-sm">
                                            <i class="bi bi-pencil"></i>
                                            Editar
                                        </a>
                                        <form action="/admin/restaurantes/<%= restaurante.id %>/excluir" method="POST" class="d-inline" onsubmit="return confirm('Tem certeza que deseja excluir este restaurante?');">
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="bi bi-trash"></i>
                                                Excluir
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</main>

<%- include('../partials/footer') %>
