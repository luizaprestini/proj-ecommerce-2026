<%- include('../partials/header') %>
<%- include('../partials/menu') %>

<main class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between">
                <h4 class="mb-0">
                    <i class="bi bi-box-seam"></i>
                    Produtos
                </h4>
                <a href="/admin/produtos/form-cadastrar" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle"></i>
                    Novo produto
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Prato</th>
                            <th>Restaurante</th>
                            <th>Categoria</th>
                            <th>Preço</th>
                            <th>Imagem</th>
                            <th>Calorias</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (produtos.length === 0) { %>
                            <tr>
                                <td colspan="8" class="text-center">Nenhum prato cadastrado.</td>
                            </tr>
                        <% } else { %>
                            <% produtos.forEach(produto => { %>
                                <tr>
                                    <td><%= produto.id %></td>
                                    <td>
                                        <strong><%= produto.nome %></strong>
                                        <% if (produto.descricao) { %>
                                            <div class="small text-muted"><%= produto.descricao %></div>
                                        <% } %>
                                    </td>
                                    <td><%= produto.restaurante || '—' %></td>
                                    <td><%= produto.categoria || '—' %></td>
                                    <td>R$ <%= Number(produto.valor || 0).toFixed(2) %></td>
                                    <td>
                                        <% if (produto.imagem) { %>
                                            <img src="/uploads/<%= produto.imagem %>" alt="Foto de <%= produto.nome %>" class="img-thumbnail" style="max-width: 90px; max-height: 70px;">
                                        <% } else { %>
                                            —
                                        <% } %>
                                    </td>
                                    <td class="small text-nowrap">
                                        <strong><%= produto.calorias == null ? '—' : Number(produto.calorias).toLocaleString('pt-BR') %></strong> kcal
                                    </td>
                                    <td>
                                        <a href="/admin/produtos/<%= produto.id %>/editar" class="btn btn-warning btn-sm">
                                            <i class="bi bi-pencil"></i>
                                            Editar
                                        </a>
                                        <form action="/admin/produtos/<%= produto.id %>/excluir" method="POST" class="d-inline" onsubmit="return confirm('Tem certeza que deseja excluir este prato?');">
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="bi bi-trash"></i>
                                                Excluir
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</main>

<%- include('../partials/footer') %>
